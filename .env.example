# psp_saves.py settings - copy to .env and fill in. Used by both the Python script and Docker Compose.
# Keep .env private: it contains your API token.

# --- RomM ----------------------------------------------------------------------
# Address of RomM as seen from where the script runs (with Docker: from inside the container,
# so not "localhost" unless RomM is on the same host network; use the host's IP or hostname).
ROMM_URL=https://romm.example.com
# RomM -> your profile -> API tokens. Needs read access to platforms/ROMs and write access to assets.
ROMM_TOKEN=

# --- Paths (on your machine) ---------------------------------------------------
# The PPSSPP SAVEDATA folder: the one whose subfolders look like ULUS10336DATA00
SAVEDATA_DIR=/path/to/PSP/SAVEDATA
# Where the archives are written
OUT_DIR=./psp-saves
# Optional: match against a local roms/psp folder instead of RomM's game list (leave empty normally)
ROMS_DIR=

# --- Matching ------------------------------------------------------------------
# Manual matches for saves the script can't match itself, separated by ";".
# Value = ROM file name without extension, exactly as in RomM.
# SERIAL_MAP=ULUS10041=Grand Theft Auto - Liberty City Stories (USA);ULJM05500=Monster Hunter Portable 3rd (Japan)
SERIAL_MAP=

# --- Advanced ------------------------------------------------------------------
# library_path of your webstation container in RomM's config.yml (only written into the archive manifest)
LIBRARY_PATH=/romm/library
# savedata = SAVEDATA/<FOLDER>/files (webstation format), flat = <FOLDER>/files
LAYOUT=savedata
# Set to true to upload on every run (otherwise pass --upload)
UPLOAD=false
# Upload even if the game already has a ppsspp save in RomM
FORCE=false
